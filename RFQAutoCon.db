record(bo, "$(P):AutoC_Start") {
	field(DTYP, "Soft Channel")
    field(DESC, "Auto Conditioning Start")
    field(ZNAM, "Stop")
    field(ONAM, "Start")
    field(VAL,  "0")
    field(PINI, "YES")
}

record(bo, "$(P):AutoC_Reset") {
	field(DTYP, "Soft Channel")
    field(DESC, "Auto Conditioning Reset")
    field(ZNAM, "Idle")
    field(ONAM, "Reset")
    field(VAL,  "0")
    field(PINI, "YES")
}

record(stringout, "$(P):AutoC_Status") {
	field(DTYP, "Soft Channel")
    field(DESC, "Auto Conditioning Status")
    field(VAL,  "Idle")
    field(PINI, "YES")
}

